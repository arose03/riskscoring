# Server-side Google Maps API key (geocoding)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Client-side Google Maps key (Places Autocomplete - restrict by HTTP referrer)
NEXT_PUBLIC_GOOGLE_MAPS_KEY=your_public_google_maps_key_here

# Anthropic API key (server-side Claude API calls)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─── Email Intake (Submission Processor) ────────────────────────────────────
# IMAP - incoming submissions inbox
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=submissions@yourdomain.com
IMAP_PASSWORD=your_app_password_here
IMAP_TLS=true
IMAP_MAILBOX=INBOX

# SMTP - outgoing reply with workbook
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=submissions@yourdomain.com
SMTP_PASSWORD=your_app_password_here
SMTP_SECURE=false
SMTP_FROM_NAME=HABGEN Underwriting
SMTP_CC_ADDRESS=ari@habgen.com

# Optional: protect /api/email/check with a secret (for external cron calls)
CRON_SECRET=your_secret_here

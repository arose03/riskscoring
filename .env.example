# Server-side Google Maps API key (geocoding + Places enrichment for ratings & website)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Client-side Google Maps key (Places Autocomplete - restrict by HTTP referrer)
NEXT_PUBLIC_GOOGLE_MAPS_KEY=your_public_google_maps_key_here

# Anthropic API key (server-side Claude API calls)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# RentCast API key (rent comps data)
RENTCAST_API_KEY=your_rentcast_api_key_here
